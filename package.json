{
  "name": "mod-manager",
  "version": "0.15.0",
  "description": "Mod manager for Thunderstore games and Minecraft (Modrinth) with shareable profile codes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js && node test-playit.js && node test-vortex.js",
    "dist": "electron-builder --win",
    "test:launcher": "node test-launcher.js",
    "test:server": "node test-server.js && node test-server-features.js && node test-server-types.js",
    "test:sync": "node test-sync.js"
  },
  "build": {
    "appId": "dev.modmanager.app",
    "productName": "Mod Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "sources/*.js",
      "build/icon.png",
      "!test.js",
      "!test-launcher.js",
      "!test-server.js",
      "!docs/**",
      "!test-server-features.js",
      "!test-server-types.js",
      "!test-playit.js",
      "!playit-*.exe",
      "!test-sync.js",
      "!test-sync-friend.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "ModManager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ModManager-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "V3rkku1",
      "repo": "mod-manager",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "dompurify": "^3.5.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "author": "Mod Manager",
  "repository": "github:V3rkku1/mod-manager"
}
